<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Follows the system light/dark setting, so prefers-color-scheme works in pages -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">#0f1115</item>
        <item name="android:navigationBarColor">#0f1115</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
